---
/*
 * Path: src/layouts/BaseLayout.astro
 * Purpose: Pure fixed-viewport HTML5 shell for SPEC-021 loading global SNES RPG styles,
 *          Press Start 2P + Inter typography, high-priority /img/boris-portrait.png preload,
 *          and structured JSON-LD metadata without legacy parallax overlays or document modals.
 * Spec Reference: SPEC-021 (021-hero-wall-full-game-overworld)
 *
 * Operator Notes:
 * - Zero document scrolling is enforced via global.css (100dvh / overflow: hidden).
 * - SnesDialogueBox and CharacterDossier own all in-game overlays and modal dialogs.
 */
const {
  title = "Boris Quijano | 16-Bit RPG Overworld — LATAM AI Sherpa",
  description = "Playable 16-bit RPG overworld portfolio for Boris Quijano, LATAM AI Sherpa and Narrative Architect in El Salvador."
} = Astro.props;

import '../styles/global.css';
const SITE = "https://boris-quijano.vercel.app";
const OG_IMG = `${SITE}/og/hero-wall-og.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Iconify runtimes for Character Dossier loadout & trophy glyphs -->
    <script defer src="https://code.iconify.design/3/3.1.1/iconify.min.js"></script>
    <script defer src="https://code.iconify.design/iconify-icon/1.0.8/iconify-icon.min.js"></script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE} />

    <!-- Social metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE} />
    <meta property="og:title" content="Boris Quijano | 16-Bit RPG Overworld" />
    <meta property="og:description" content="Explore five SNES biomes, meet the party, and inspect real shipped AI systems." />
    <meta property="og:image" content={OG_IMG} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured Person metadata -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Boris Quijano",
      url: SITE,
      email: "mailto:boris.quijano@live.com",
      jobTitle: "LATAM AI Sherpa, Digital Strategist & Narrative Architect",
      sameAs: ["https://github.com/BlizzardGhost"]
    })} />

    <!-- Retro arcade & readable UI fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Press+Start+2P&display=swap" rel="stylesheet" />

    <!-- Pixel shield favicon -->
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 fill=%22%23090d16%22/><path d=%22M32 8l12 12H20zM22 38h8v14h-8zM34 38h8v14h-8z%22 fill=%22%23facc15%22/></svg>"
    />

    <!-- Preload Boris's authentic Character Dossier portrait at high priority -->
    <link rel="preload" href="/img/boris-portrait.png" as="image" fetchpriority="high" />
  </head>
  <body>
    <a href="#main" class="skip-link visually-hidden">Skip to game stage</a>
    <slot />
  </body>
</html>
