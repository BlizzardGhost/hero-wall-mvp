---
/*
 * Path: src/components/About.astro
 * Purpose: Zone 1 (Sanctuary Citadel) rendering Boris Quijano Level 39 dossier,
 *          Sovereign Abstract, memorial tribute to Emy, Kiba, and Yue, RPG stats matrix,
 *          and 13-item Loadout Belt while preserving the legacy #about anchor.
 * Spec Reference: SPEC-020 (020-hero-wall-16bit-overworld-implementation)
 */
import data from "../data/hero.json";

const rawHero = data?.hero ?? {
  name: "Boris",
  title: "LATAM AI Sherpa",
  level: 39,
  protocol: "RASS v39.1.3",
  category: "Explorer / Builder / Teacher"
};

const DASH_CHARS = new RegExp(`\\s*[${String.fromCharCode(0x2014, 0x2013)}]\\s*`, "g");
const NB_HYPHEN = new RegExp(String.fromCharCode(0x2011), "g");

const sanitizeText = (value: unknown): string =>
  String(value ?? "")
    .replace(DASH_CHARS, ", ")
    .replace(NB_HYPHEN, "-")
    .trim();

const hero = {
  ...rawHero,
  category: String(rawHero.category ?? "Explorer / Builder / Teacher")
    .replace(DASH_CHARS, " / ")
};

const abstract = sanitizeText(data?.abstract ?? "");
---

<section id="sanctuary" data-zone="sanctuary" class="section zone-section">
  <div id="about" class="inner">
    <h2 class="banner">Sanctuary Citadel</h2>

    <div class="panel md3-profile-card" style="margin-top:12px">
      <!-- Top Hero Header Bar -->
      <div class="profile-header">
        <div class="holo-avatar-wrap">
          <div class="holo-avatar">
            <img src="/img/boris-portrait.png" alt="Boris Quijano hologram portrait" loading="lazy" />
            <div class="scanlines" aria-hidden="true"></div>
          </div>
          <div class="level-badge" data-tip="Current Level">
            <span class="lvl-prefix">LVL</span>
            <span class="lvl-number">{hero.level}</span>
          </div>
        </div>

        <div class="profile-title-block">
          <div class="profile-badges-row">
            <span class="md3-badge-pill protocol"><iconify-icon icon="pixelarticons:zap" aria-hidden="true"></iconify-icon> {hero.protocol}</span>
            <span class="md3-badge-pill category"><iconify-icon icon="pixelarticons:flag" aria-hidden="true"></iconify-icon> {hero.category}</span>
            <span class="md3-badge-pill sanctuary"><iconify-icon icon="pixelarticons:home" aria-hidden="true"></iconify-icon> El Salvador</span>
          </div>
          <h3 class="profile-name">Boris Quijano</h3>
          <div class="profile-subtitle">LATAM AI Sherpa, Digital Strategist, and Narrative Architect</div>
        </div>
      </div>

      <!-- Sovereign Abstract Quote -->
      {abstract && (
        <div class="abstract-quote-box">
          <div class="quote-header">
            <iconify-icon icon="pixelarticons:script" aria-hidden="true"></iconify-icon>
            <span>SOVEREIGN COMPASS &amp; ABSTRACT</span>
          </div>
          <p class="quote-text">{abstract}</p>
        </div>
      )}

      <!-- Dedicated Tribute to Memorial Companions: Emy, Kiba, and Yue -->
      <aside class="memorial-tribute-box" aria-label="Memorial tribute to Emy, Kiba, and Yue">
        <div class="memorial-tribute-text">
          <div class="memorial-header">
            <iconify-icon icon="pixelarticons:heart" aria-hidden="true"></iconify-icon>
            <h3>Memorial Companions: Emy, Kiba, and Yue</h3>
          </div>
          <p>
            On the overworld road, a white pixel dog trots beside Boris in memory of Emy, Kiba, and Yue. They walked through an earlier chapter in Medellin and stayed part of the story after the move back to El Salvador.
          </p>
        </div>
        <button type="button" class="btn secondary tribute-btn" data-open-memorial>
          Honor Emy, Kiba &amp; Yue (B)
        </button>
      </aside>

      <!-- RPG Stats Matrix -->
      <div class="charcard-v2">
        <div class="cc-stats-grid">
          <div class="stat-cell">
            <span class="iconify" data-icon="game-icons:crown" aria-hidden="true"></span>
            <div class="stat-meta">
              <span class="stat-label">Class</span>
              <span class="stat-value">Narrative Architect</span>
            </div>
          </div>

          <div class="stat-cell">
            <span class="iconify" data-icon="mdi:robot-happy-outline" aria-hidden="true"></span>
            <div class="stat-meta">
              <span class="stat-label">Spec</span>
              <span class="stat-value">Technomancy (AI + Systems)</span>
            </div>
          </div>

          <div class="stat-cell">
            <span class="iconify" data-icon="mdi:handshake-outline" aria-hidden="true"></span>
            <div class="stat-meta">
              <span class="stat-label">Alignment</span>
              <span class="stat-value">Chaotic Good</span>
            </div>
          </div>

          <div class="stat-cell">
            <span class="iconify" data-icon="mdi:atom-variant" aria-hidden="true"></span>
            <div class="stat-meta">
              <span class="stat-label">Era</span>
              <span class="stat-value">Sovereign Age (4th Life)</span>
            </div>
          </div>

          <div class="stat-cell">
            <span class="iconify" data-icon="game-icons:upgrade" aria-hidden="true"></span>
            <div class="stat-meta">
              <span class="stat-label">Experience</span>
              <span class="stat-value">15+ years across IT, Marketing, and AI Systems</span>
            </div>
          </div>

          <div class="stat-cell">
            <span class="iconify" data-icon="mdi:translate-variant" aria-hidden="true"></span>
            <div class="stat-meta">
              <span class="stat-label">Language</span>
              <span class="stat-value">EN / ES (Bicultural US &amp; LATAM)</span>
            </div>
          </div>
        </div>

        <!-- Tech Loadout Belt -->
        <div class="loadout-wrap-v2">
          <div class="loadout-label-bar">
            <iconify-icon icon="pixelarticons:briefcase" aria-hidden="true"></iconify-icon>
            <span>EQUIPPED LOADOUT &amp; TECH STACK</span>
          </div>

          <div class="loadout-belt">
            <div class="loadout-bar" id="loadoutBar">
              <span class="loadout-chip" data-tip="Design Systems"><span class="iconify" data-icon="simple-icons:figma" aria-hidden="true"></span>Figma</span>
              <span class="loadout-chip" data-tip="Docs & Ops"><span class="iconify" data-icon="simple-icons:notion" aria-hidden="true"></span>Notion</span>
              <span class="loadout-chip" data-tip="Backend Runtime"><span class="iconify" data-icon="mdi:nodejs" aria-hidden="true"></span>Node</span>
              <span class="loadout-chip" data-tip="Fast Runtime & Bundler"><span class="iconify" data-icon="simple-icons:bun" aria-hidden="true"></span>Bun</span>
              <span class="loadout-chip" data-tip="Rapid UI"><span class="iconify" data-icon="mdi:tailwind" aria-hidden="true"></span>Tailwind</span>
              <span class="loadout-chip" data-tip="No-Code Automations"><span class="iconify" data-icon="simple-icons:zap" aria-hidden="true"></span>Zapier</span>
              <span class="loadout-chip" data-tip="API Workflows"><span class="iconify" data-icon="mdi:pipe-disconnected" aria-hidden="true"></span>Pipedream</span>
              <span class="loadout-chip" data-tip="Islands & Speed"><span class="iconify" data-icon="simple-icons:astro" aria-hidden="true"></span>Astro</span>
              <span class="loadout-chip" data-tip="Edge Deploys"><span class="iconify" data-icon="simple-icons:vercel" aria-hidden="true"></span>Vercel</span>
              <span class="loadout-chip" data-tip="CDN & Security"><span class="iconify" data-icon="simple-icons:cloudflare" aria-hidden="true"></span>Cloudflare</span>
              <span class="loadout-chip" data-tip="Edge AI Models"><span class="iconify" data-icon="simple-icons:google" aria-hidden="true"></span>Gemini</span>
              <span class="loadout-chip" data-tip="Text to Video"><span class="iconify" data-icon="mdi:movie-open-outline" aria-hidden="true"></span>Sora</span>
              <span class="loadout-chip" data-tip="Image Gen"><span class="iconify" data-icon="mdi:image-auto-adjust" aria-hidden="true"></span>Genspark</span>
              <button type="button" class="loadout-chip rare" id="chipChatGPT" data-tip="Fear is for NPCs. Level 13 unlocked.">
                <span class="iconify" data-icon="mdi:chat-processing-outline" aria-hidden="true"></span>ChatGPT
              </button>
            </div>

            <!-- Keep nav wrapper exposed in accessibility tree because its buttons receive focus -->
            <div class="loadout-nav">
              <button type="button" class="nav-btn left" id="loadoutPrev" aria-label="Scroll loadout left">
                <span class="iconify" data-icon="mdi:chevron-left" aria-hidden="true"></span>
              </button>
              <button type="button" class="nav-btn right" id="loadoutNext" aria-label="Scroll loadout right">
                <span class="iconify" data-icon="mdi:chevron-right" aria-hidden="true"></span>
              </button>
            </div>

            <div class="fade left" aria-hidden="true"></div>
            <div class="fade right" aria-hidden="true"></div>
          </div>

          <div id="loadoutEaster" class="easter-msg">
            <span class="hint">Hint:</span> hover or activate the last chip for a surprise...
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .md3-profile-card {
      background: linear-gradient(180deg, rgba(20, 38, 54, 0.95) 0%, rgba(13, 21, 28, 0.98) 100%);
      border: 2px solid rgba(56, 199, 231, 0.35);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    .profile-header {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-bottom: 20px;
    }
    .holo-avatar-wrap {
      position: relative;
      flex-shrink: 0;
    }
    .holo-avatar {
      width: 104px;
      height: 104px;
      border-radius: 12px;
      overflow: hidden;
      border: 3px solid rgba(56, 199, 231, 0.6);
      box-shadow: 0 0 20px rgba(56, 199, 231, 0.35);
      background: #0d151c;
      position: relative;
    }
    .holo-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .holo-avatar .scanlines {
      position: absolute;
      inset: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 4px;
      pointer-events: none;
    }
    .level-badge {
      position: absolute;
      bottom: -8px;
      right: -8px;
      background: linear-gradient(135deg, #ffd166 0%, #e09f3e 100%);
      color: #0d151c;
      border: 2px solid #000;
      border-radius: 8px;
      padding: 3px 7px;
      font-family: 'Press Start 2P', system-ui;
      box-shadow: 0 3px 0 #000;
      display: flex;
      flex-direction: column;
      align-items: center;
      line-height: 1;
    }
    .level-badge .lvl-prefix { font-size: 8px; font-weight: bold; }
    .level-badge .lvl-number { font-size: 13px; font-weight: 900; }

    .profile-title-block { flex: 1; min-width: 0; }
    .profile-badges-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .md3-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      font-family: 'Press Start 2P', monospace;
      letter-spacing: -0.5px;
      background: rgba(56, 199, 231, 0.1);
      border: 1px solid rgba(56, 199, 231, 0.3);
      color: #38C7E7;
    }
    .md3-badge-pill.protocol { color: #ffd166; border-color: rgba(255, 209, 102, 0.4); background: rgba(255, 209, 102, 0.1); }
    .md3-badge-pill.sanctuary { color: #06d6a0; border-color: rgba(6, 214, 160, 0.4); background: rgba(6, 214, 160, 0.1); }
    .profile-name {
      font-family: 'Press Start 2P', system-ui;
      font-size: clamp(16px, 2.5vw, 24px);
      margin: 0 0 6px;
      color: #fff;
      text-shadow: 0 2px 0 #000, 0 0 12px rgba(56, 199, 231, 0.4);
    }
    .profile-subtitle {
      color: #b8d9ea;
      font-size: 14px;
      line-height: 1.4;
    }

    .abstract-quote-box {
      margin-top: 14px;
      margin-bottom: 18px;
      padding: 14px 18px;
      background: rgba(56, 199, 231, 0.06);
      border-left: 1px solid #38C7E7;
      border-radius: 0 8px 8px 0;
    }
    .quote-header {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: #38C7E7;
      margin-bottom: 6px;
      letter-spacing: 0.5px;
    }
    .quote-text {
      margin: 0;
      color: #e9f7ff;
      font-size: 14px;
      line-height: 1.55;
      font-style: italic;
    }

    .memorial-tribute-box {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 20px;
      padding: 14px 16px;
      background: rgba(244, 227, 195, 0.07);
      border: 1px solid rgba(244, 227, 195, 0.35);
      border-radius: 10px;
    }
    .memorial-tribute-text {
      flex: 1 1 280px;
      min-width: 0;
    }
    .memorial-header {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #F4E3C3;
      margin-bottom: 6px;
    }
    .memorial-header h3 {
      margin: 0;
      font-family: 'Press Start 2P', monospace;
      font-size: 11px;
      line-height: 1.4;
      color: #F4E3C3;
    }
    .memorial-tribute-text p {
      margin: 0;
      font-size: 13.5px;
      line-height: 1.5;
      color: #e9dfd0;
    }
    .tribute-btn {
      font-size: 10px;
      padding: 10px 14px;
      border-color: #F4E3C3;
      color: #F4E3C3;
      white-space: normal;
      text-align: center;
      max-width: 100%;
    }

    .cc-stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 12px;
      margin-bottom: 22px;
    }
    .stat-cell {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      background: rgba(28, 59, 84, 0.35);
      border: 1px solid rgba(56, 199, 231, 0.2);
      border-radius: 8px;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .stat-cell:hover {
      border-color: rgba(56, 199, 231, 0.5);
      background: rgba(28, 59, 84, 0.55);
    }
    .stat-cell .iconify {
      font-size: 24px;
      color: #38C7E7;
      flex-shrink: 0;
    }
    .stat-meta {
      display: flex;
      flex-direction: column;
    }
    .stat-label {
      font-size: 11px;
      color: #8dafc2;
      text-transform: uppercase;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .stat-value {
      font-size: 13px;
      font-weight: 600;
      color: #ffffff;
    }

    .loadout-wrap-v2 {
      margin-top: 14px;
    }
    .loadout-label-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: #ffd166;
      margin-bottom: 10px;
    }
    button.loadout-chip {
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .profile-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .holo-avatar {
        width: 88px;
        height: 88px;
      }
      .cc-stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // Easter egg (long hover or click on Level 13 rare chip)
    const chip = document.getElementById('chipChatGPT');
    const msg  = document.getElementById('loadoutEaster');
    let hoverTimer;
    const LINES = [
      "RASS is watching you. Calculating curiosity score.",
      "Ms. Devil will punish you for being too curious. Proceed.",
      "Siege Mode: curiosity detected. Bonus XP awarded.",
      "You found Level 13. Most mortals stop at 12."
    ];
    const randLine = () => LINES[Math.floor(Math.random() * LINES.length)];
    function openEgg(){
      msg?.classList.add('show');
      if (window.HeroWallModal && window.HeroWallModal.open) {
        window.HeroWallModal.open({
          title: "Secret Loadout: Level 13",
          html: `<p>${randLine()}</p>`
        });
      } else if (msg) {
        msg.innerHTML = `<span class="hint">Secret:</span> ${randLine()}`;
      }
    }
    chip?.addEventListener('mouseenter', () => { hoverTimer = setTimeout(openEgg, 1200); });
    chip?.addEventListener('mouseleave', () => { clearTimeout(hoverTimer); });
    chip?.addEventListener('click', openEgg);

    // Loadout belt horizontal scroll controls (respecting reduced-motion preference)
    const bar = document.getElementById('loadoutBar');
    const prev = document.getElementById('loadoutPrev');
    const next = document.getElementById('loadoutNext');
    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateNav() {
      if (!bar) return;
      const maxScroll = bar.scrollWidth - bar.clientWidth - 1;
      prev?.classList.toggle('disabled', bar.scrollLeft <= 0);
      next?.classList.toggle('disabled', bar.scrollLeft >= maxScroll);
    }
    function scrollBelt(direction) {
      if (!bar) return;
      const step = bar.clientWidth * 0.6;
      bar.scrollBy({ left: direction * step, behavior: reduceMotion() ? 'auto' : 'smooth' });
      setTimeout(updateNav, 420);
    }
    prev?.addEventListener('click', () => scrollBelt(-1));
    next?.addEventListener('click', () => scrollBelt(1));
    bar?.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('load', updateNav);
  </script>
</section>
