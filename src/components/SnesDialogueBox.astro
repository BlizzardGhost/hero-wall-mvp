---
/**
 * Path: src/components/SnesDialogueBox.astro
 * Purpose: Contained SNES 16-bit floating dialogue overlay (`#snesDialogueBox` with
 *          offset glowing speaker nameplate, 2-3 line chunks, animated `▼` advance
 *          arrow), unified Pokémon `[START]` Command Pause Menu (`#pokemonStartMenu` with
 *          Dossier, Relics, Town Map portal warps, Badges, Transmit, Settings, Credits,
 *          Resume), floating hotspot prompt (`#interactionPrompt`), companion morale
 *          toast (`#moraleToast`), and accessible live region (`#overworldLiveRegion`).
 * Spec Reference: SPEC-022 (022-hero-wall-studio-cozy-rebuild)
 *
 * Operator Notes:
 * - Mounted inside `.crt-bezel-frame` / `.overworld-viewport`. Hidden by default in the
 *   `EXPLORING` state via native `hidden` so the pixel hearth & portals stay unobstructed.
 * - `#snesDialogueBox` uses `overflow: visible` on the outer frame so the offset glowing
 *   speaker nameplate (`#snesSpeakerName`) sits cleanly astride the upper-left gold border,
 *   while `.snes-dialogue-scroll` handles bounded internal scrolling (`overscroll-behavior: contain`).
 * - `#pokemonStartMenu` implements `focusgroup="menu nomemory"` with an automatic Up/Down/
 *   Home/End fallback when `!('focusGroup' in HTMLElement.prototype)` per modern-web-guidance `menu`.
 * - `#settingMotionBtn` omits `aria-pressed` because its label toggles between Pause/Play motion.
 */
import {
  BIOME_LIST,
  SIGNAL_BEACON,
  START_MENU_COMMANDS,
  TROPHY_CARDS,
} from '../data/game-content';
---

<!-- Floating Hotspot Proximity Prompt Pill (shown in EXPLORING state when near a hotspot) -->
<button
  type="button"
  id="interactionPrompt"
  class="interaction-prompt"
  hidden
>
  <span class="interaction-prompt-key" aria-hidden="true">SPACE / A</span>
  <span id="interactionPromptLabel" class="interaction-prompt-label">Inspect Hotspot</span>
</button>

<!-- Companion Morale Status Toast (+10 Morale Restored when petting The Dog) -->
<div
  id="moraleToast"
  class="morale-toast"
  role="status"
  aria-label="Morale notification"
  hidden
>
  <span class="morale-toast-icon" aria-hidden="true">&#9829;</span>
  <span id="moraleToastText" class="morale-toast-text">+10 Morale Restored</span>
  <button
    type="button"
    id="moraleToastClose"
    class="morale-toast-close"
    aria-label="Dismiss morale notification"
  >
    &times;
  </button>
</div>

<!-- Persistent non-hidden live region for screen-reader status announcements -->
<span
  id="overworldLiveRegion"
  class="visually-hidden"
  aria-live="polite"
  aria-atomic="true"
></span>

<!-- Contained Floating SNES Dialogue & Inspector Window -->
<section
  id="snesDialogueBox"
  class="snes-dialogue-box"
  data-speaker="[BORIS]"
  aria-labelledby="snesDialogueTitle"
  aria-describedby="snesDialogueText"
  hidden
>
  <!-- Offset glowing speaker nameplate astride top-left double border -->
  <div class="snes-speaker-nameplate">
    <span class="snes-speaker-glyph" aria-hidden="true">&#9654;</span>
    <span id="snesSpeakerName" class="snes-speaker-name">[BORIS]</span>
  </div>

  <header class="snes-dialogue-header">
    <h2 id="snesDialogueTitle" class="snes-dialogue-title">
      CAMPFIRE SANCTUARY · HEARTH
    </h2>
    <span id="snesStatePill" class="snes-state-pill">DIALOGUE</span>
  </header>

  <div class="snes-dialogue-scroll">
    <div class="snes-dialogue-body">
      <p id="snesDialogueText" class="snes-dialogue-text"></p>

      <!-- Rich inline inspector for Era Monoliths, Relic Pods, Armory Lodge, Signal Beacon -->
      <div id="snesInspectorContent" class="snes-inspector-content" hidden></div>

      <!-- Interactive choice buttons and prev/next carousel controls -->
      <div
        id="snesChoiceList"
        class="snes-choice-list"
        role="group"
        aria-label="Dialogue options"
        hidden
      ></div>
    </div>
  </div>

  <footer class="snes-dialogue-footer snes-dialogue-actions">
    <button
      type="button"
      id="snesContinueBtn"
      class="snes-btn snes-btn-primary snes-footer-btn"
    >
      <span>Advance</span>
      <span class="snes-advance-arrow" aria-hidden="true">&#9660;</span>
    </button>
    <button
      type="button"
      id="snesCloseBtn"
      class="snes-btn snes-btn-secondary snes-footer-btn"
    >
      Close [ESC / B]
    </button>
  </footer>
</section>

<!-- Unified Pokémon [START] Command Pause Menu -->
<section
  id="pokemonStartMenu"
  class="pokemon-start-menu"
  data-active-subpanel="town-map"
  aria-labelledby="startMenuTitle"
  hidden
>
  <header class="start-menu-header">
    <div class="start-menu-heading">
      <span class="start-menu-kicker">[START] PAUSE MENU</span>
      <h2 id="startMenuTitle" class="start-menu-title">
        SHERPA COMMAND · BORIS LVL 39
      </h2>
    </div>
    <span id="startMenuRoomReadout" class="start-menu-room-badge">Campfire Sanctuary</span>
  </header>

  <div class="start-menu-grid">
    <!-- Left Column: Classic Pokémon Vertical RPG Command List -->
    <nav class="start-menu-nav" aria-label="Game pause commands">
      <div
        id="startMenuCommandList"
        class="start-menu-commands"
        focusgroup="menu nomemory"
        aria-labelledby="startMenuTitle"
      >
        {START_MENU_COMMANDS.map((cmd) => (
          <button
            type="button"
            class="start-menu-cmd"
            data-menu-action={cmd.action}
            aria-expanded={
              cmd.action === 'town-map'
                ? 'true'
                : cmd.action === 'settings' || cmd.action === 'transmit'
                  ? 'false'
                  : undefined
            }
          >
            <span class="start-cmd-cursor" aria-hidden="true">&#9654;</span>
            <span class="start-cmd-label">{cmd.label}</span>
            <span class="start-cmd-hint" aria-hidden="true">{cmd.hint}</span>
          </button>
        ))}
        <hr class="start-menu-sep" />
        <button
          type="button"
          id="startMenuResumeBtn"
          class="start-menu-cmd start-menu-cmd--resume"
          data-menu-action="resume"
        >
          <span class="start-cmd-cursor" aria-hidden="true">&#9654;</span>
          <span class="start-cmd-label">Resume</span>
          <span class="start-cmd-hint" aria-hidden="true">ESC / M</span>
        </button>
      </div>
    </nav>

    <!-- Right Column: Town Map Portal Warps, Settings Toggles, and Transmit Channels -->
    <div class="start-menu-detail-pane">
      <!-- Sub-panel 1: Town Map (Fast-Travel Dimensional Portal Warps) -->
      <div class="start-subpanel" data-start-panel="town-map">
        <div class="start-subpanel-head">
          <h3 class="start-subpanel-title">TOWN MAP · DIMENSIONAL PORTALS</h3>
          <p class="start-subpanel-note">
            Warp directly between the Campfire Sanctuary hub and the 3 alien frontiers.
          </p>
        </div>
        <div class="start-warp-list" role="group" aria-label="Room fast-travel portals">
          {BIOME_LIST.map((room) => (
            <button
              type="button"
              class="start-warp-btn"
              data-warp-room={room.id}
              style={`--room-accent: ${room.accentCss};`}
            >
              <span class="start-warp-key" aria-hidden="true">{room.hotkey}</span>
              <span class="start-warp-meta">
                <strong class="start-warp-name">{room.name}</strong>
                <span class="start-warp-desc">{room.townMapSummary}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- Sub-panel 2: Audio, Campfire Crackle, CRT Scanlines, Celestial Sky & Motion -->
      <div class="start-subpanel" data-start-panel="settings" hidden>
        <div class="start-subpanel-head">
          <h3 class="start-subpanel-title">STUDIO SETTINGS · PERSISTENT</h3>
          <p class="start-subpanel-note">
            Toggles save automatically to local storage across rooms and visits.
          </p>
        </div>
        <div class="start-settings-list" role="group" aria-label="Display, audio, and motion settings">
          <button type="button" id="settingAudioBtn" class="start-setting-btn" data-state="on">
            <span class="setting-name">16-Bit SFX Audio</span>
            <span class="setting-val">ON</span>
          </button>
          <button type="button" id="settingCrackleBtn" class="start-setting-btn" data-state="on">
            <span class="setting-name">Campfire Crackle</span>
            <span class="setting-val">ON</span>
          </button>
          <button type="button" id="settingCrtBtn" class="start-setting-btn" data-state="on">
            <span class="setting-name">CRT Scanlines</span>
            <span class="setting-val">ON</span>
          </button>
          <button type="button" id="settingSkyBtn" class="start-setting-btn" data-state="auto">
            <span class="setting-name">Celestial Sky</span>
            <span class="setting-val">AUTO</span>
          </button>
          <!-- Omit aria-pressed when button text toggles Pause/Play motion per WCAG 2.2.2 -->
          <button type="button" id="settingMotionBtn" class="start-setting-btn" data-state="playing">
            <span class="setting-name">Ambient Motion</span>
            <span class="setting-val">Pause motion</span>
          </button>
        </div>
      </div>

      <!-- Sub-panel 3: Signal Beacon Direct Transmission Channels -->
      <div class="start-subpanel" data-start-panel="transmit" hidden>
        <div class="start-subpanel-head">
          <h3 class="start-subpanel-title">TRANSMIT · SIGNAL BEACON</h3>
          <p class="start-subpanel-note">
            Open direct coordinates for consulting, AI engineering, or advisory sessions.
          </p>
        </div>
        <div class="start-transmit-list">
          {SIGNAL_BEACON.channels.map((channel) => {
            const isHttp = channel.val.startsWith('http');
            return (
              <a
                class="start-transmit-link"
                href={channel.val}
                target={isHttp ? '_blank' : undefined}
                rel={isHttp ? 'noopener noreferrer' : undefined}
              >
                <span class="transmit-type">{channel.type}</span>
                <strong class="transmit-label">{channel.label}</strong>
                <span class="transmit-val">{channel.val.replace('mailto:', '')}</span>
              </a>
            );
          })}
        </div>
        <p class="start-subpanel-foot">
          Trophy Armory Archive: {TROPHY_CARDS.length} Battle Cards unlocked/tracked in Dossier.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement for #pokemonStartMenu sub-panel switching and focusgroup="menu nomemory"
  // arrow-key navigation fallback when !('focusGroup' in HTMLElement.prototype).
  (() => {
    const win = window as unknown as {
      __RASS_START_MENU_UI_WIRED__?: boolean;
      __RASS_OVERWORLD_DEBUG__?: boolean;
      PokemonStartMenuUI?: {
        showSubpanel: (panelId: 'town-map' | 'settings' | 'transmit') => void;
      };
    };

    if (win.__RASS_START_MENU_UI_WIRED__) return;
    win.__RASS_START_MENU_UI_WIRED__ = true;

    const startMenu = document.getElementById('pokemonStartMenu');
    const cmdList = document.getElementById('startMenuCommandList');
    if (!startMenu || !cmdList) return;

    const panels = Array.from(startMenu.querySelectorAll<HTMLElement>('[data-start-panel]'));
    const subTriggers = Array.from(
      cmdList.querySelectorAll<HTMLButtonElement>('[data-menu-action]')
    );

    const showSubpanel = (panelId: 'town-map' | 'settings' | 'transmit') => {
      startMenu.setAttribute('data-active-subpanel', panelId);
      for (const panel of panels) {
        panel.hidden = panel.dataset.startPanel !== panelId;
      }
      for (const btn of subTriggers) {
        const action = btn.dataset.menuAction;
        if (action === 'town-map' || action === 'settings' || action === 'transmit') {
          btn.setAttribute('aria-expanded', String(action === panelId));
        }
      }
      if (win.__RASS_OVERWORLD_DEBUG__) {
        console.debug('[HeroWall:StartMenuUI] subpanel ->', panelId);
      }
    };

    cmdList.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('[data-menu-action]');
      const action = btn?.dataset.menuAction;
      if (action === 'town-map' || action === 'settings' || action === 'transmit') {
        showSubpanel(action);
      }
    });

    // Apply menu ARIA roles + Up/Down/Home/End navigation only when native focusgroup is absent.
    if (!('focusGroup' in HTMLElement.prototype)) {
      cmdList.setAttribute('role', 'menu');
      cmdList.querySelectorAll<HTMLButtonElement>('button:not([role])').forEach((item) => {
        item.setAttribute('role', 'menuitem');
      });
      cmdList.addEventListener('keydown', (e) => {
        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(e.key)) return;
        const items = Array.from(cmdList.querySelectorAll<HTMLButtonElement>('button')).filter(
          (item) => !item.disabled && item.getAttribute('aria-disabled') !== 'true'
        );
        const current = items.indexOf(document.activeElement as HTMLButtonElement);
        if (current < 0 || items.length === 0) return;
        const next =
          e.key === 'Home'
            ? 0
            : e.key === 'End'
              ? items.length - 1
              : (current + (e.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
        e.preventDefault();
        e.stopPropagation();
        items[next]?.focus({ preventScroll: true });
      });
    }

    win.PokemonStartMenuUI = { showSubpanel };
  })();
</script>

<style>
  /* Compact floating proximity prompt inside .crt-bezel-frame / .overworld-viewport */
  .interaction-prompt {
    position: absolute;
    left: 50%;
    bottom: max(12px, env(safe-area-inset-bottom, 0px) + 8px);
    transform: translateX(-50%);
    z-index: 22;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 24px);
    min-block-size: 34px;
    padding: 6px 12px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    line-height: 1.35;
    color: #f8fafc;
    background: linear-gradient(180deg, rgba(23, 37, 84, 0.96) 0%, rgba(9, 13, 22, 0.98) 100%);
    border: 2px solid #facc15;
    box-shadow:
      0 0 0 2px #090d16,
      0 4px 14px rgba(0, 0, 0, 0.65);
    cursor: pointer;
    appearance: none;
  }

  .interaction-prompt[hidden] {
    display: none;
  }

  .interaction-prompt-key {
    padding: 2px 5px;
    background: #090d16;
    border: 1px solid #06b6d4;
    color: #facc15;
    font-size: 8px;
    flex-shrink: 0;
  }

  .interaction-prompt-label {
    color: #f4e3c3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .interaction-prompt:focus-visible {
    outline: 3px solid #06b6d4;
    outline-offset: 2px;
  }

  /* Companion morale status toast anchored top-right inside .crt-bezel-frame */
  .morale-toast {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 28;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 24px);
    padding: 7px 10px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    line-height: 1.4;
    color: #f4e3c3;
    background: linear-gradient(180deg, #172554 0%, #090d16 100%);
    border: 2px solid #facc15;
    box-shadow:
      inset 0 0 0 2px #f8fafc,
      0 6px 16px rgba(0, 0, 0, 0.72);
  }

  .morale-toast[hidden] {
    display: none;
  }

  .morale-toast-icon {
    color: #facc15;
    font-size: 12px;
    line-height: 1;
  }

  .morale-toast-text {
    color: #facc15;
  }

  .morale-toast-close {
    appearance: none;
    display: inline-grid;
    place-items: center;
    min-inline-size: 26px;
    min-block-size: 26px;
    padding: 0 4px;
    margin-left: 2px;
    background: #090d16;
    color: #f8fafc;
    border: 1px solid rgba(248, 250, 252, 0.55);
    font-family: inherit;
    font-size: 12px;
    line-height: 1;
    cursor: pointer;
  }

  /* Contained Floating SNES RPG Dialogue Box (centered, max-width 680px, offset glowing nameplate) */
  .snes-dialogue-box {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: max(12px, env(safe-area-inset-bottom, 0px) + 10px);
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(
      680px,
      calc(100% - max(20px, env(safe-area-inset-left, 0px) + env(safe-area-inset-right, 0px) + 16px))
    );
    max-width: 680px;
    /* Reserve 34px at top so offset speaker nameplate never clips against viewport bezel */
    max-height: calc(100% - 34px);
    padding: 16px 15px 12px;
    overflow: visible;
    color: #f8fafc;
    background: linear-gradient(180deg, rgba(23, 37, 84, 0.97) 0%, rgba(9, 13, 22, 0.98) 100%);
    border: 3px solid #facc15;
    outline: 2px solid #f8fafc;
    outline-offset: -6px;
    border-radius: 6px;
    box-shadow:
      0 0 0 3px #090d16,
      0 14px 30px rgba(0, 0, 0, 0.85);
  }

  .snes-dialogue-box[hidden] {
    display: none;
  }

  /* Offset glowing speaker nameplate sitting atop the upper-left gold frame */
  .snes-speaker-nameplate {
    position: absolute;
    top: -15px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: linear-gradient(180deg, #0f172a 0%, #090d16 100%);
    border: 2px solid var(--speaker-glow, #06b6d4);
    border-radius: 4px;
    box-shadow:
      0 0 0 2px #090d16,
      0 0 12px color-mix(in srgb, var(--speaker-glow, #06b6d4) 55%, transparent);
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    line-height: 1.3;
    color: var(--speaker-glow, #06b6d4);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .snes-dialogue-box[data-speaker='[BORIS]'] { --speaker-glow: #facc15; }
  .snes-dialogue-box[data-speaker='[RASS]'] { --speaker-glow: #38c7e7; }
  .snes-dialogue-box[data-speaker='[MS. DEVIL]'] { --speaker-glow: #f97316; }
  .snes-dialogue-box[data-speaker='[THE DOG]'] { --speaker-glow: #f4e3c3; }
  .snes-dialogue-box[data-speaker='[TERMINAL]'] { --speaker-glow: #a855f7; }

  .snes-speaker-glyph {
    color: var(--speaker-glow, #f97316);
    font-size: 8.5px;
  }

  .snes-dialogue-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 10px;
    padding-bottom: 6px;
    border-bottom: 2px solid rgba(250, 204, 21, 0.35);
  }

  .snes-dialogue-title {
    margin: 0;
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(8.5px, 1.25vw, 10.5px);
    line-height: 1.45;
    color: #facc15;
    letter-spacing: 0.03em;
  }

  .snes-state-pill {
    flex-shrink: 0;
    padding: 3px 7px;
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    line-height: 1.3;
    text-transform: uppercase;
    color: #090d16;
    background: #facc15;
    border: 2px solid #f8fafc;
  }

  .snes-dialogue-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .snes-dialogue-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .snes-dialogue-text {
    margin: 0;
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: clamp(13px, 1.35vw, 15px);
    line-height: 1.5;
    color: #f4e3c3;
    white-space: pre-line;
    text-wrap: pretty;
  }

  .snes-inspector-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 10px;
    background: rgba(9, 13, 22, 0.78);
    border: 2px solid rgba(6, 182, 212, 0.45);
  }

  .snes-inspector-content[hidden] {
    display: none;
  }

  .snes-choice-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .snes-choice-list[hidden] {
    display: none;
  }

  .snes-dialogue-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding-top: 4px;
  }

  .snes-advance-arrow {
    display: inline-block;
    color: #facc15;
    font-size: 9px;
    line-height: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .snes-advance-arrow {
      animation: snesAdvanceBounce 0.85s ease-in-out infinite;
    }
  }

  @keyframes snesAdvanceBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  html[data-motion='paused'] .snes-advance-arrow {
    animation: none !important;
  }

  .snes-btn,
  .snes-choice-list :global(.snes-choice-btn),
  .snes-inspector-content :global(.snes-inspector-link),
  .snes-inspector-content :global(.snes-nav-btn) {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-block-size: 34px;
    padding: 6px 10px;
    font-family: 'Press Start 2P', monospace;
    font-size: 8.5px;
    line-height: 1.35;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid #06b6d4;
    background: #10203a;
    color: #f8fafc;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.7), 0 2px 0 #090d16;
  }

  .snes-btn-primary,
  .snes-inspector-content :global(.snes-inspector-link) {
    border-color: #facc15;
    background: #1e3a8a;
    color: #facc15;
  }

  .snes-btn-secondary {
    border-color: rgba(248, 250, 252, 0.65);
    background: #0f172a;
    color: #f4e3c3;
  }

  /* ============================================================================
   * Unified Pokémon [START] Command Pause Menu (#pokemonStartMenu)
   * ============================================================================ */
  .pokemon-start-menu {
    position: absolute;
    inset: 10px;
    margin: auto;
    z-index: 35;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(640px, calc(100% - 16px));
    max-height: calc(100% - 16px);
    padding: 12px 14px;
    color: #f8fafc;
    background: linear-gradient(180deg, rgba(23, 37, 84, 0.98) 0%, rgba(9, 13, 22, 0.99) 100%);
