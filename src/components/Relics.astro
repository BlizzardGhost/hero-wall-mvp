---
import { relics } from '../data/relics';
---

<section id="work" class="section">
  <div class="inner">
    <div class="banner">Featured Relics &amp; Work</div>
    <p class="relic-lede">Every quest brings a relic — production systems shipped to the world.</p>

    <div class="panel md3-work-panel">
      <div class="relics-grid-v2">
        {relics.map((r) => (
          <article class="relic-card-v2">
            <div class="relic-holo-frame">
              <img src={r.img} alt={`${r.title} preview`} loading="lazy" />
              <div class="relic-scanlines" aria-hidden="true"></div>
            </div>

            <div class="relic-content">
              <div class="relic-category">{r.category}</div>
              <h3 class="relic-title">{r.title}</h3>
              <p class="relic-desc">{r.desc}</p>

              <div class="relic-tags">
                {r.tags.map(t => (
                  <span class="relic-tag">{t}</span>
                ))}
              </div>

              {r.href && (
                <div class="relic-action">
                  <a class="btn secondary relic-btn" href={r.href} target="_blank" rel="noopener noreferrer">
                    <span>Inspect Relic</span>
                    <iconify-icon icon="pixelarticons:external-link"></iconify-icon>
                  </a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <style>
    .md3-work-panel {
      background: linear-gradient(180deg, rgba(20, 36, 50, 0.95) 0%, rgba(10, 20, 30, 0.98) 100%);
      border: 2px solid rgba(56, 199, 231, 0.3);
      border-radius: 12px;
      padding: 24px;
    }
    .relic-lede {
      color: #b0cddb;
      margin: 8px 0 16px;
      font-size: 14px;
    }
    .relics-grid-v2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 22px;
    }
    .relic-card-v2 {
      background: rgba(28, 59, 84, 0.35);
      border: 2px solid rgba(56, 199, 231, 0.25);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .relic-card-v2:hover {
      transform: translateY(-4px);
      border-color: rgba(56, 199, 231, 0.7);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 15px rgba(56, 199, 231, 0.25);
    }
    .relic-holo-frame {
      position: relative;
      height: 180px;
      background: #0a141c;
      overflow: hidden;
      border-bottom: 2px solid rgba(56, 199, 231, 0.2);
    }
    .relic-holo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .relic-card-v2:hover .relic-holo-frame img {
      transform: scale(1.05);
    }
    .relic-scanlines {
      position: absolute;
      inset: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
      background-size: 100% 4px;
      pointer-events: none;
    }
    .relic-content {
      padding: 16px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .relic-category {
      font-size: 11px;
      color: #38C7E7;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }
    .relic-title {
      font-family: 'Press Start 2P', system-ui;
      font-size: 14px;
      margin: 0 0 8px;
      color: #ffffff;
      line-height: 1.3;
    }
    .relic-desc {
      font-size: 13px;
      color: #c0d8e8;
      line-height: 1.5;
      margin: 0 0 14px;
      flex: 1;
    }
    .relic-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 16px;
    }
    .relic-tag {
      font-size: 11px;
      background: rgba(56, 199, 231, 0.1);
      border: 1px solid rgba(56, 199, 231, 0.25);
      color: #9cd6e8;
      padding: 3px 8px;
      border-radius: 12px;
      font-weight: 500;
    }
    .relic-action {
      margin-top: auto;
    }
    .relic-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      text-align: center;
      padding: 10px 14px;
      font-size: 10px;
    }
  </style>
</section>
