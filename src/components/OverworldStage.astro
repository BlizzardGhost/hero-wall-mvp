---
/**
 * Path: src/components/OverworldStage.astro
 * Purpose: Full-viewport 16-bit RPG Overworld console shell (`#overworldStage` /
 *          `.overworld-shell`) pairing a compact SNES Top HUD Bar (`.overworld-bezel-top`),
 *          full-bleed PixiJS/Canvas game screen (`.overworld-viewport`) with overlaid
 *          `<SnesDialogueBox />` and accessible `#overworldFallback`, and a tactile
 *          desktop/mobile Game Boy Advance controller deck (`.gba-controller-deck`).
 * Spec Reference: SPEC-021 (021-hero-wall-full-game-overworld)
 *
 * Operator Notes:
 * - Desktop (> 900px) frames the stage as a widescreen 16-bit CRT filling 100dvh.
 * - Mobile (<= 900px) splits into a 58dvh top game viewport + 42dvh bottom controller deck.
 * - `#motionToggle` intentionally omits `aria-pressed` per WCAG 2.2.2 / modern-web-guidance motion.
 */
import SnesDialogueBox from "./SnesDialogueBox.astro";
---

<div
  id="overworldStage"
  class="overworld-stage overworld-shell"
  data-zone-active="sanctuary"
>
  <h1 id="overworldMainHeading" class="visually-hidden" tabindex="-1">
    Boris Quijano, Level 39 LATAM AI Sherpa: 16-Bit RPG Overworld
  </h1>

  <!-- Top HUD Bar -->
  <header class="overworld-bezel-top">
    <div class="ow-status-group">
      <div class="ow-char-chip" aria-label="Hero status: Boris Level 39, HP 100 of 100, MP 999 of 999">
        <span class="ow-char-name">BORIS · LVL 39</span>
        <span class="ow-char-vitals">HP 100/100 · MP 999/999</span>
      </div>
      <span id="overworldZoneLabel" class="ow-zone-readout">
        1. Sanctuary Campfire
      </span>
      <span id="gameStateBadge" class="ow-state-badge">
        EXPLORING
      </span>
    </div>

    <nav class="ow-travel-nav" aria-label="Overworld Fast Travel">
      <button
        type="button"
        class="ow-travel-btn is-active"
        data-travel-zone="sanctuary"
        aria-current="true"
      >
        <span class="ow-key-cap" aria-hidden="true">1</span>
        <span>Sanctuary</span>
      </button>
      <button
        type="button"
        class="ow-travel-btn"
        data-travel-zone="eras"
      >
        <span class="ow-key-cap" aria-hidden="true">2</span>
        <span>Eras</span>
      </button>
      <button
        type="button"
        class="ow-travel-btn"
        data-travel-zone="relics"
      >
        <span class="ow-key-cap" aria-hidden="true">3</span>
        <span>Relics</span>
      </button>
      <button
        type="button"
        class="ow-travel-btn"
        data-travel-zone="trophies"
      >
        <span class="ow-key-cap" aria-hidden="true">4</span>
        <span>Trophies</span>
      </button>
      <button
        type="button"
        class="ow-travel-btn"
        data-travel-zone="beacon"
      >
        <span class="ow-key-cap" aria-hidden="true">5</span>
        <span>Beacon</span>
      </button>
    </nav>

    <div class="ow-tool-group" role="group" aria-label="Overworld display, audio, and dossier controls">
      <button
        type="button"
        id="celestialToggle"
        class="ow-tool-btn"
        aria-label="Toggle day or night sky"
      >
        <span aria-hidden="true">☀️ / 🌙</span>
      </button>
      <button
        type="button"
        id="audioToggle"
        class="ow-tool-btn"
        data-muted="false"
      >
        Mute SFX
      </button>
      <button
        type="button"
        id="motionToggle"
        class="ow-tool-btn"
      >
        Pause motion
      </button>
      <button
        type="button"
        id="btnOpenDossier"
        class="ow-tool-btn ow-dossier-btn"
      >
        [C] Dossier
      </button>
      <span
        id="rendererBadge"
        class="ow-renderer-badge"
        data-backend="pending"
        title="Active PixiJS rendering backend"
      >
        webgpu
      </span>
    </div>
  </header>

  <!-- Game Screen Viewport (Canvas Host + Accessible Fallback + SNES Dialogue Overlay) -->
  <div class="overworld-viewport">
    <div id="overworldCanvasHost" class="overworld-canvas-host">
      <div id="overworldFallback" class="overworld-fallback">
        <p class="ow-fallback-title">16-Bit Sherpa Overworld (Accessible Stage Mode)</p>
        <p class="ow-fallback-copy">
          Party: Boris (Level 39 Sherpa), White Dog (memorial companion honoring Emy, Kiba, and Yue),
          RASS drone, and Ms. Devil. Open the Character Dossier terminal or use Fast Travel to explore
          all five biomes, relics, trophies, and contact channels.
        </p>
        <div class="ow-fallback-actions">
          <button
            type="button"
            id="fallbackOpenDossier"
            class="ow-action-btn ow-fallback-dossier-btn"
            data-open-dossier
          >
            Open [C] Character Dossier
          </button>
        </div>
        <noscript>
          <p class="ow-fallback-copy">
            JavaScript is disabled. Enable JavaScript to walk the 5-biome overworld and launch the [C] Character Dossier.
          </p>
        </noscript>
      </div>
    </div>

    <SnesDialogueBox />
  </div>

  <!-- Bottom Controller / Tactile Game Boy Deck -->
  <div class="gba-controller-deck" role="region" aria-label="Overworld controller deck">
    <div class="gba-dpad-grid" role="group" aria-label="Directional pad">
      <button
        type="button"
        id="dpadUp"
        class="gba-dpad-btn"
        data-dpad="up"
        aria-label="Move up"
      >
        <span aria-hidden="true">&#9650;</span>
      </button>
      <button
        type="button"
        id="dpadLeft"
        class="gba-dpad-btn"
        data-dpad="left"
        aria-label="Move left"
      >
        <span aria-hidden="true">&#9664;</span>
      </button>
      <span class="gba-dpad-center" aria-hidden="true"></span>
      <button
        type="button"
        id="dpadRight"
        class="gba-dpad-btn"
        data-dpad="right"
        aria-label="Move right"
      >
        <span aria-hidden="true">&#9654;</span>
      </button>
      <button
        type="button"
        id="dpadDown"
        class="gba-dpad-btn"
        data-dpad="down"
        aria-label="Move down"
      >
        <span aria-hidden="true">&#9660;</span>
      </button>
    </div>

    <div class="gba-system-group" role="group" aria-label="System buttons">
      <button type="button" id="btnStartDossier" class="gba-sys-btn">
        [START / C] <span class="visually-hidden">Character Dossier</span>
      </button>
      <button type="button" id="btnSelectRoast" class="gba-sys-btn">
        [SELECT / R] <span class="visually-hidden">Roast Chest</span>
      </button>
    </div>

    <div class="gba-quick-group" role="group" aria-label="Quick companion and chest actions">
      <button type="button" id="dogPetTrigger" class="ow-action-btn ow-action-dog">
        Pet Dog [B]
      </button>
      <button type="button" id="roastChestTrigger" class="ow-action-btn ow-action-chest">
        Roast Chest [R]
      </button>
      <span class="ow-controls-hint">
        WASD/Arrows: Walk · Space: Action · C: Dossier · B: Dog · R: Roast · 1-5: Biomes
      </span>
    </div>

    <div class="gba-ab-group" role="group" aria-label="Action buttons">
      <button type="button" id="btnActionB" class="gba-ab-btn">
        [B / Dog]
      </button>
      <button type="button" id="btnActionA" class="gba-ab-btn">
        [A / Space]
      </button>
    </div>
  </div>
</div>

<script>
  import { initOverworld } from '../scripts/overworld-engine';

  const wireFallbackDossierTrigger = () => {
    const fallbackBtn = document.getElementById('fallbackOpenDossier');
    if (!fallbackBtn || fallbackBtn.dataset.wired === '1') return;
    fallbackBtn.dataset.wired = '1';
    fallbackBtn.addEventListener('click', () => {
      const terminal = (window as unknown as {
        CharacterDossierTerminal?: { open?: (tabId?: string) => void };
      }).CharacterDossierTerminal;
      terminal?.open?.('status');
    });
  };

  const bootOverworld = () => {
    wireFallbackDossierTrigger();
    try {
      void Promise.resolve(initOverworld()).catch((err) => {
        if ((window as unknown as { __RASS_OVERWORLD_DEBUG__?: boolean }).__RASS_OVERWORLD_DEBUG__) {
          console.warn('[OverworldStage] Engine init failed; accessible fallback remains active.', err);
        }
      });
    } catch (err) {
      if ((window as unknown as { __RASS_OVERWORLD_DEBUG__?: boolean }).__RASS_OVERWORLD_DEBUG__) {
        console.warn('[OverworldStage] Sync engine boot error; accessible fallback remains active.', err);
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootOverworld, { once: true });
  } else {
    bootOverworld();
  }

  document.addEventListener('astro:page-load', bootOverworld);
</script>

<style>
  /*
   * Minimal :where() styling complements global.css without specificity conflicts.
   */
  :where(.ow-controls-hint) {
    font-size: 11px;
    color: #94a3b8;
    white-space: nowrap;
  }

  :where(.ow-fallback-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
