---
/**
 * Path: src/components/OverworldStage.astro
 * Purpose: Full-viewport 16-bit RPG studio console shell (`#overworldStage` /
 *          `.overworld-shell`) pairing a sleek single-row Top HUD Bezel
 *          (`.overworld-bezel-top` with zero mobile overlap/clipping down to 320px),
 *          responsive letterboxed `.crt-bezel-frame` wrapping `#overworldCanvasHost`,
 *          static `#overworldFallback`, `<SnesDialogueBox />` (including `#pokemonStartMenu`),
 *          `.crt-scanlines` layer, and tactile `.gba-controller-deck`.
 * Spec Reference: SPEC-022 (022-hero-wall-studio-cozy-rebuild)
 *
 * Operator Notes:
 * - Eliminates the overflowing multi-button SPEC-021 mobile header (ref_mobile_ccdd2656.jpg):
 *   Fast Travel, Audio, Crackle, CRT, Celestial Sky, and Transmit live inside the unified
 *   Pokémon `#pokemonStartMenu` triggered by `#btnOpenStartMenu` / `#btnStartDossier` / [M] / [ESC].
 * - Desktop (> 900px) letterboxes the 960x540 (16:9) pixel stage inside `.crt-bezel-frame`.
 * - Mobile (<= 900px) enforces the 58dvh top viewport + 42dvh bottom `.gba-controller-deck`
 *   so thumbs never obscure Boris, The Dog, RASS, Ms. Devil, or portals.
 * - `#motionToggle` omits `aria-pressed` per WCAG 2.2.2 / modern-web-guidance `motion`
 *   because its visible text toggles between `Pause motion` and `Play motion`.
 */
import SnesDialogueBox from "./SnesDialogueBox.astro";
---

<div
  id="overworldStage"
  class="overworld-stage overworld-shell"
  data-zone-active="campfire"
>
  <h1 id="overworldMainHeading" class="visually-hidden" tabindex="-1">
    Boris Quijano, Level 39 LATAM AI Sherpa: Cozy Campfire Sanctuary and Alien Frontiers 16-Bit RPG
  </h1>

  <!-- Sleek Single-Row Top Bezel HUD (fits 320px+ mobile without clipping or wrapping) -->
  <header class="overworld-bezel-top">
    <div class="ow-status-group">
      <div class="ow-char-chip" aria-label="Hero status: Boris Level 39">
        <span class="ow-char-name">BORIS · LVL 39</span>
      </div>
      <span id="overworldZoneLabel" class="ow-zone-readout">
        Campfire Sanctuary
      </span>
      <span id="gameStateBadge" class="ow-state-badge">
        EXPLORING
      </span>
    </div>

    <div class="ow-tool-group" role="group" aria-label="Start menu, motion control, and rendering backend">
      <button
        type="button"
        id="btnOpenStartMenu"
        class="ow-tool-btn ow-start-btn"
        aria-controls="pokemonStartMenu"
        aria-expanded="false"
      >
        [START]
      </button>
      <!-- Omit aria-pressed when button label toggles Pause/Play motion per WCAG 2.2.2 -->
      <button
        type="button"
        id="motionToggle"
        class="ow-tool-btn"
      >
        Pause motion
      </button>
      <span
        id="rendererBadge"
        class="ow-renderer-badge"
        data-backend="pending"
        title="Active PixiJS rendering backend"
      >
        webgpu
      </span>
    </div>
  </header>

  <!-- Primary Viewport & Responsive Letterboxed CRT Frame -->
  <div class="overworld-viewport">
    <div class="crt-bezel-frame">
      <div id="overworldCanvasHost" class="overworld-canvas-host">
        <div id="overworldFallback" class="overworld-fallback">
          <p class="ow-fallback-title">Campfire Sanctuary &amp; Alien Frontiers (Accessible Stage)</p>
          <p class="ow-fallback-copy">
            Campfire Sanctuary: Boris (Level 39 Sherpa), The Dog resting on a woven mat by the embers,
            RASS holographic companion, and Ms. Devil on the timber bench. Open the [C] Character Dossier
            or press [START] to warp across Cyber-Chasm, Bio-Forge Spire, and Signal Beacon.
          </p>
          <div class="ow-fallback-actions">
            <button
              type="button"
              id="fallbackOpenDossier"
              class="ow-action-btn ow-fallback-dossier-btn"
              data-open-dossier
            >
              [C] Open Dossier
            </button>
          </div>
          <noscript>
            <p class="ow-fallback-copy">
              JavaScript is disabled. Enable JavaScript to walk the Campfire Sanctuary, enter the
              three alien portals, and launch the [C] Character Dossier.
            </p>
          </noscript>
        </div>
      </div>

      <SnesDialogueBox />
      <div class="crt-scanlines" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Tactile Handheld Controller Deck (Desktop bottom strip -> Mobile 42dvh deck) -->
  <div class="gba-controller-deck" role="region" aria-label="Overworld controller deck">
    <div class="gba-dpad-grid" role="group" aria-label="Directional pad">
      <button
        type="button"
        id="dpadUp"
        class="gba-dpad-btn"
        data-dpad="up"
        aria-label="Move up"
      >
        <span aria-hidden="true">&#9650;</span>
      </button>
      <button
        type="button"
        id="dpadLeft"
        class="gba-dpad-btn"
        data-dpad="left"
        aria-label="Move left"
      >
        <span aria-hidden="true">&#9664;</span>
      </button>
      <span class="gba-dpad-center" aria-hidden="true"></span>
      <button
        type="button"
        id="dpadRight"
        class="gba-dpad-btn"
        data-dpad="right"
        aria-label="Move right"
      >
        <span aria-hidden="true">&#9654;</span>
      </button>
      <button
        type="button"
        id="dpadDown"
        class="gba-dpad-btn"
        data-dpad="down"
        aria-label="Move down"
      >
        <span aria-hidden="true">&#9660;</span>
      </button>
    </div>

    <div class="gba-system-group" role="group" aria-label="System buttons">
      <button type="button" id="btnStartDossier" class="gba-sys-btn" aria-label="START: Open Pause Menu">
        START
      </button>
      <button type="button" id="btnSelectRoast" class="gba-sys-btn" aria-label="SELECT: Open Mimic Roast Chest">
        SELECT
      </button>
    </div>

    <div class="gba-quick-group" role="group" aria-label="Quick companion, chest, and dossier actions">
      <button type="button" id="dogPetTrigger" class="ow-action-btn ow-action-dog">
        Pet Dog [B]
      </button>
      <button type="button" id="roastChestTrigger" class="ow-action-btn ow-action-chest">
        Roast Chest [R]
      </button>
      <button type="button" id="btnOpenDossier" class="ow-action-btn ow-dossier-btn">
        [C] Dossier
      </button>
      <span class="ow-controls-hint">
        WASD/Arrows: Walk · Space: Action · M/START: Menu · C: Dossier · B: Dog · R: Roast · H: Campfire · 1-4: Rooms
      </span>
    </div>

    <div class="gba-ab-group" role="group" aria-label="Action buttons">
      <button type="button" id="btnActionB" class="gba-ab-btn" aria-label="B: Pet Dog or Back">
        B
      </button>
      <button type="button" id="btnActionA" class="gba-ab-btn" aria-label="A: Interact or Advance">
        A
      </button>
    </div>
  </div>
</div>

<script>
  import { initOverworld } from '../scripts/overworld-engine';

  // Ensure accessible fallback button works immediately even if WebGPU/Canvas fails to mount.
  const wireFallbackDossierTrigger = () => {
    const fallbackBtn = document.getElementById('fallbackOpenDossier');
    if (!fallbackBtn || fallbackBtn.dataset.wired === '1') return;
    fallbackBtn.dataset.wired = '1';
    fallbackBtn.addEventListener('click', () => {
      const terminal = (window as unknown as {
        CharacterDossierTerminal?: { open?: (tabId?: string) => void };
      }).CharacterDossierTerminal;
      terminal?.open?.('status');
    });
  };

  let engineBooted = false;

  // Boot the single-canvas PixiJS/Canvas2D engine once per page lifecycle.
  const bootOverworld = () => {
    wireFallbackDossierTrigger();
    if (engineBooted) return;
    engineBooted = true;
    try {
      void Promise.resolve(initOverworld()).catch((err) => {
        engineBooted = false;
        if ((window as unknown as { __RASS_OVERWORLD_DEBUG__?: boolean }).__RASS_OVERWORLD_DEBUG__) {
          console.warn('[OverworldStage] Engine init failed; accessible fallback remains active.', err);
        }
      });
    } catch (err) {
      engineBooted = false;
      if ((window as unknown as { __RASS_OVERWORLD_DEBUG__?: boolean }).__RASS_OVERWORLD_DEBUG__) {
        console.warn('[OverworldStage] Sync engine boot error; accessible fallback remains active.', err);
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootOverworld, { once: true });
  } else {
    bootOverworld();
  }

  document.addEventListener('astro:page-load', bootOverworld);
</script>

<style>
  /*
   * Low-specificity :where() helpers complementing global.css without specificity collisions.
   */
  :where(.ow-controls-hint) {
    font-size: 11px;
    color: #94a3b8;
    white-space: nowrap;
  }

  :where(.ow-fallback-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
