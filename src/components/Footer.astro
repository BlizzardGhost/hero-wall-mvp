---
/*
 * Path: src/components/Footer.astro
 * Purpose: Grounded site footer with active Infusio, KidsLab, WhatsApp, and email links.
 * Spec Reference: SPEC-020 (020-hero-wall-16bit-overworld-implementation)
 */
const {
  infusionUrl = "https://infusio.pro",
  kidslabUrl = "https://kidslab.lat",
  email = "boris.quijano@live.com",
  whatsapp = "+503 7118 0568"
} = Astro.props;

const whatsappHref = `https://wa.me/${whatsapp.replace(/[^0-9]/g, "")}`;
---
<footer class="container site-footer">
  <div class="row footer-top">
    <div>© {new Date().getFullYear()} Boris Quijano | Hero Wall</div>
    <nav class="row footer-links" aria-label="Footer links">
      <a class="glow" href={infusionUrl} target="_blank" rel="noopener noreferrer">Infusio</a>
      <a class="glow" href={kidslabUrl} target="_blank" rel="noopener noreferrer">KidsLab</a>
      <a class="glow" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="glow" href={`mailto:${email}`}>Email</a>
    </nav>
  </div>
  <div class="subtitle footer-credit">
    Built by RASS &amp; Ms. Devil, Directed by Boris. (Achievement not unlocked: VP of Endless Meetings)
  </div>
</footer>
