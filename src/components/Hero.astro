---
/*
 * Path: src/components/Hero.astro
 * Purpose: Above-the-fold Hero entry point orienting visitors to the 16-bit Overworld,
 *          Sanctuary Citadel (#sanctuary), and Roast Chest dialog trigger.
 * Spec Reference: SPEC-020 (020-hero-wall-16bit-overworld-implementation)
 */
---

<section class="hero" aria-label="Hero arrival">
  <div class="hero-content">
    <div class="hero-text">
      <h1 class="title">Your Hero for AI-Powered Web Systems</h1>
      <p class="subtitle">
        Walk the 16-bit overworld with Boris, RASS, Ms. Devil, and our white dog companion, or jump straight into five field zones.
      </p>
      <div class="hero-ctas">
        <a class="btn primary" href="#sanctuary">PRESS START</a>
        <a class="btn secondary" href="#overworldStage">Explore World</a>
        <button type="button" class="btn ghost" id="heroRoastBtn" data-open-roast>Open Roast Chest</button>
      </div>
    </div>
    <!-- Right column stays open so the hero pixel illustration remains unobstructed on desktop -->
    <div aria-hidden="true"></div>
  </div>
</section>
