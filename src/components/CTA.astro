---
/*
 * Path: src/components/CTA.astro
 * Purpose: Zone 5 (Signal Beacon) providing direct email, WhatsApp (+503 7118 0568),
 *          and calendar booking links while keeping legacy #contact anchor compatibility.
 * Spec Reference: SPEC-020 (020-hero-wall-16bit-overworld-implementation)
 */
const {
  email = "boris.quijano@live.com",
  whatsapp = "+503 7118 0568",
  href
} = Astro.props;

const resolvedMailto = href ?? `mailto:${email}`;
const whatsappHref = `https://wa.me/${whatsapp.replace(/[^0-9]/g, "")}`;
const calendarHref = `mailto:${email}?subject=${encodeURIComponent("Hero Wall Discovery Call & Calendar Booking")}`;
---

<section id="beacon" data-zone="beacon" class="section zone-section">
  <div id="contact" class="inner">
    <h2 class="banner">Signal Beacon</h2>
    <div class="panel md3-cta-panel" style="margin-top:12px">
      <div class="cta-inner-row">
        <div class="cta-text-block">
          <p class="cta-quote">
            "Traveler, if you need a builder of systems and a teller of stories, send a signal here."
          </p>
          <div class="cta-meta">
            Available for AI engineering, technical leadership, and custom web systems from El Salvador (UTC-6).
          </div>
          <div class="beacon-channels">
            <span>Direct Email: <strong>{email}</strong></span>
            <span>WhatsApp: <strong>{whatsapp}</strong></span>
          </div>
        </div>
        <div class="cta-actions">
          <a class="btn primary cta-btn" href={resolvedMailto}>
            <span>Email Boris</span>
            <iconify-icon icon="pixelarticons:mail" aria-hidden="true"></iconify-icon>
          </a>
          <a class="btn secondary cta-btn" href={whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp {whatsapp}</span>
            <iconify-icon icon="pixelarticons:chat" aria-hidden="true"></iconify-icon>
          </a>
          <a class="btn ghost cta-btn" href={calendarHref}>
            <span>Book Calendar Slot</span>
            <iconify-icon icon="pixelarticons:calendar" aria-hidden="true"></iconify-icon>
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .md3-cta-panel {
      background: linear-gradient(180deg, rgba(20, 36, 50, 0.95) 0%, rgba(10, 20, 30, 0.98) 100%);
      border: 2px solid rgba(56, 199, 231, 0.3);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }
    .cta-inner-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }
    .cta-text-block {
      flex: 1 1 300px;
      min-width: 0;
    }
    .cta-quote {
      margin: 0 0 8px;
      font-size: 15px;
      line-height: 1.5;
      color: #e2f0fa;
      font-style: italic;
    }
    .cta-meta {
      font-size: 13px;
      color: #a9c8da;
      line-height: 1.45;
    }
    .beacon-channels {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      margin-top: 12px;
      font-size: 13px;
      color: #d3e7f3;
    }
    .beacon-channels strong {
      color: #ffd166;
    }
    .cta-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }
    .cta-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      padding: 12px 18px;
      font-size: 10px;
      white-space: normal;
      text-align: center;
      max-width: 100%;
    }
  </style>
</section>
