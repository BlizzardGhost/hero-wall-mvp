---
const { href } = Astro.props;
---

<section id="contact" class="section">
  <div class="inner">
    <div class="banner">Start a Quest Together</div>
    <div class="panel md3-cta-panel" style="margin-top:12px">
      <div class="cta-inner-row">
        <div class="cta-text-block">
          <p class="cta-quote">
            “So, traveler… do you seek a builder of systems or a teller of stories? In me, you will find both.”
          </p>
          <div class="cta-meta">Available for AI Engineering, Executive Strategy &amp; System Architecture.</div>
        </div>
        <a class="btn primary cta-btn" href={href}>
          <span>Initiate Contact</span>
          <iconify-icon icon="pixelarticons:mail"></iconify-icon>
        </a>
      </div>
    </div>
  </div>

  <style>
    .md3-cta-panel {
      background: linear-gradient(180deg, rgba(20, 36, 50, 0.95) 0%, rgba(10, 20, 30, 0.98) 100%);
      border: 2px solid rgba(56, 199, 231, 0.3);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }
    .cta-inner-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }
    .cta-text-block {
      flex: 1;
      min-width: 260px;
    }
    .cta-quote {
      margin: 0 0 6px;
      font-size: 15px;
      line-height: 1.5;
      color: #e2f0fa;
      font-style: italic;
    }
    .cta-meta {
      font-size: 12px;
      color: #8dafc2;
    }
    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 22px;
      font-size: 11px;
      white-space: nowrap;
    }
  </style>
</section>
