---
import { badges as defaultBadges } from '../data/badges';

// Accept badges via props or fall back to data file
type Tier = 'ultimate' | 'prestige' | 'special' | 'locked';
type Badge = {
  name: string;
  caption: string;
  icon: string;
  xp?: number | null;
  tier: Tier;
  earned: boolean;
  tooltip?: string;
  lore?: string;
  category: string;
  date?: string;
  level?: number | null;
};

const input: Badge[] = (Astro.props.badges as Badge[]) ?? defaultBadges;

// Sort: Tier → Date (desc)
const order: Record<Tier, number> = { ultimate: 0, prestige: 1, special: 2, locked: 3 };
const sorted: Badge[] = [...input].sort((a, b) => {
  const tierDelta = order[a.tier] - order[b.tier];
  if (tierDelta) return tierDelta;
  return (b.date ?? '').localeCompare(a.date ?? '');
});
---

<section id="trophies" class="section">
  <div class="inner">
    <div class="banner">Trophies &amp; Achievements</div>

    <div class="panel md3-trophies-panel" style="margin-top:12px">
      <!-- Top Controls & Filter Bar -->
      <div class="trophies-toolbar">
        <div class="filter-tabs" id="badgeFilters">
          <button class="filter-chip active" data-filter="all">All Cards ({sorted.length})</button>
          <button class="filter-chip" data-filter="earned">Unlocked ({sorted.filter(b => b.earned).length})</button>
          <button class="filter-chip" data-filter="pending">Pending Quests ({sorted.filter(b => !b.earned && b.tier !== 'locked').length})</button>
          <button class="filter-chip" data-filter="ultimate">Ultimate ({sorted.filter(b => b.tier === 'ultimate').length})</button>
          <button class="filter-chip" data-filter="locked">Mystery / Locked</button>
        </div>

        <div class="lore-toggle-wrap">
          <label class="badge-lore-toggle">
            <input id="loreToggle" type="checkbox" />
            <span class="lore-indicator"></span>
            <span class="label">Lore Mode</span>
          </label>
        </div>
      </div>

      <!-- Pokémon-Card Style Badge Grid -->
      <div class="pokemon-badge-grid" id="badgeGrid">
        {sorted.map((b, index) => {
          const iconSrc = b.icon?.startsWith('/') ? b.icon : `/badges/${b.icon}`;
          const lvl = (b.name.match(/Lvl\s*(\d+)/)?.[1]) ?? '';
          const categoryName = (b.category ?? 'system').toUpperCase();
          const cardNum = String(index + 1).padStart(3, '0');

          return (
            <div
              class={`pokemon-card tier-${b.tier} ${b.earned ? 'unlocked' : 'locked'}`}
              data-tier={b.tier}
              data-earned={b.earned ? 'true' : 'false'}
              data-pending={!b.earned && b.tier !== 'locked' ? 'true' : 'false'}
              data-tip={b.tooltip}
              data-category={b.category}
            >
              <!-- Card Header: Type Tag & XP Rating -->
              <div class="poke-head">
                <span class={`poke-type-badge ${b.category}`}>
                  <iconify-icon icon={
                    b.category === 'system' ? 'pixelarticons:cpu' :
                    b.category === 'sanctuary' ? 'pixelarticons:home' :
                    b.category === 'discipline' ? 'pixelarticons:shield' :
                    b.category === 'burn' ? 'pixelarticons:zap' :
                    b.category === 'food' ? 'pixelarticons:heart' :
                    b.category === 'urban' ? 'pixelarticons:human-handsup' :
                    'pixelarticons:coin'
                  }></iconify-icon>
                  {categoryName}
                </span>
                <span class="poke-hp-xp">
                  {b.xp != null ? `${b.xp} XP` : '???'}
                </span>
              </div>

              <!-- Artwork Frame with Holographic Glow & Fallback Shields -->
              <div class="poke-art-frame">
                <div class="holo-shimmer" aria-hidden="true"></div>
                {b.icon?.includes(':') ? (
                  <div class="poke-vector-wrap">
                    <svg class="poke-shield-bg" viewBox="0 0 100 100" aria-hidden="true">
                      <polygon points="50,5 90,20 90,65 50,95 10,65 10,20" fill="rgba(56,199,231,0.12)" stroke="rgba(56,199,231,0.5)" stroke-width="2"/>
                    </svg>
                    <iconify-icon icon={b.icon} class="poke-art-icon" aria-hidden="true"></iconify-icon>
                  </div>
                ) : (
                  <img
                    src={iconSrc}
                    alt={b.name}
                    loading="lazy"
                    onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                  />
                  <div class="poke-fallback-shield" style="display:none;" aria-hidden="true">
                    <svg viewBox="0 0 100 100" width="64" height="64">
                      <polygon points="50,5 90,20 90,65 50,95 10,65 10,20" fill="rgba(255,209,102,0.15)" stroke="#ffd166" stroke-width="3"/>
                      <circle cx="50" cy="48" r="16" fill="rgba(56,199,231,0.25)" stroke="#38c7e7" stroke-width="2"/>
                    </svg>
                  </div>
                )}
                {lvl && <div class="poke-lvl-stamp">LVL {lvl}</div>}
              </div>

              <!-- Card Body: Title & Ability / Caption -->
              <div class="poke-body">
                <h4 class="poke-title">{b.name}</h4>
                <p class="poke-caption">{b.caption}</p>
                {b.lore && (
                  <div class="poke-lore-box">
                    <span class="lore-label">LORE:</span>
                    <span class="lore-text">{b.lore}</span>
                  </div>
                )}
              </div>

              <!-- Card Footer with Rarity Stamp & Number -->
              <div class="poke-card-footer">
                <span class={`poke-rarity-stamp ${b.tier}`}>
                  {b.tier === 'ultimate' ? '★ ULTIMATE RARE' :
                   b.tier === 'prestige' ? '◆ PRESTIGE' :
                   b.tier === 'special' ? '▲ SPECIAL' : '🔒 LOCKED'}
                </span>
                <span class="poke-card-id">#HQ-{cardNum}</span>
              </div>

              <!-- Holographic Foil Sheen Overlay -->
              <div class="holo-foil-overlay" aria-hidden="true"></div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <style>
    .md3-trophies-panel {
      background: linear-gradient(180deg, rgba(20, 36, 50, 0.95) 0%, rgba(10, 20, 30, 0.98) 100%);
      border: 2px solid rgba(56, 199, 231, 0.3);
      border-radius: 12px;
      padding: 22px;
    }
    .trophies-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 24px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(56, 199, 231, 0.2);
    }
    .filter-tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .filter-chip {
      background: rgba(28, 59, 84, 0.4);
      border: 1px solid rgba(56, 199, 231, 0.3);
      color: #cde6f5;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .filter-chip:hover {
      background: rgba(56, 199, 231, 0.2);
      border-color: rgba(56, 199, 231, 0.6);
      color: #fff;
    }
    .filter-chip.active {
      background: #38C7E7;
      color: #0d151c;
      border-color: #38C7E7;
      font-weight: bold;
      box-shadow: 0 0 12px rgba(56, 199, 231, 0.4);
    }

    .lore-toggle-wrap {
      display: flex;
      align-items: center;
    }
    .badge-lore-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-family: 'Press Start 2P', monospace;
      font-size: 11px;
      color: #ffd166;
    }
    .badge-lore-toggle input { display: none; }
    .lore-indicator {
      width: 14px;
      height: 14px;
      border: 2px solid #ffd166;
      border-radius: 3px;
      background: transparent;
      display: inline-block;
      position: relative;
      transition: background 0.2s ease;
    }
    .badge-lore-toggle input:checked + .lore-indicator {
      background: #ffd166;
      box-shadow: 0 0 8px #ffd166;
    }

    /* Pokemon-Style Badge Grid */
    .pokemon-badge-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
    }

    .pokemon-card {
      position: relative;
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      background: linear-gradient(145deg, #162a3b 0%, #0c1822 100%);
      border: 3px solid rgba(56, 199, 231, 0.35);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s ease, border-color 0.25s ease;
      cursor: pointer;
      overflow: hidden;
    }
    .pokemon-card:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.7), 0 0 20px rgba(56, 199, 231, 0.35);
      border-color: rgba(56, 199, 231, 0.75);
    }

    /* Tier Styles */
    .pokemon-card.tier-ultimate {
      border-color: #ffd166;
      box-shadow: 0 6px 20px rgba(255, 209, 102, 0.25), inset 0 0 12px rgba(255, 209, 102, 0.15);
    }
    .pokemon-card.tier-ultimate:hover {
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 209, 102, 0.45);
    }
    .pokemon-card.tier-prestige {
      border-color: #38C7E7;
    }
    .pokemon-card.tier-special {
      border-color: #06d6a0;
    }
    .pokemon-card.locked {
      filter: grayscale(0.85) opacity(0.7);
      border-color: rgba(140, 160, 180, 0.3);
    }
    .pokemon-card.locked:hover {
      filter: grayscale(0.5) opacity(0.9);
    }

    /* Card Head */
    .poke-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .poke-type-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(56, 199, 231, 0.15);
      color: #38C7E7;
      border: 1px solid rgba(56, 199, 231, 0.4);
      letter-spacing: 0.5px;
    }
    .poke-type-badge.sanctuary { background: rgba(6, 214, 160, 0.2); color: #06d6a0; border-color: #06d6a0; }
    .poke-type-badge.discipline { background: rgba(255, 209, 102, 0.2); color: #ffd166; border-color: #ffd166; }
    .poke-type-badge.burn { background: rgba(193, 46, 40, 0.2); color: #ff7570; border-color: #ff7570; }

    .poke-hp-xp {
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: #ffd166;
      text-shadow: 0 1px 2px #000;
    }

    /* Art Frame */
    .poke-art-frame {
      position: relative;
      height: 140px;
      background: radial-gradient(circle at center, #1e3a52 0%, #0d1a24 100%);
      border: 2px solid rgba(0, 0, 0, 0.6);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 12px;
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6);
    }
    .poke-art-frame img {
      max-height: 110px;
      max-width: 90%;
      object-fit: contain;
      image-rendering: pixelated;
      transition: transform 0.3s ease;
    }
    .pokemon-card:hover .poke-art-frame img {
      transform: scale(1.08);
    }
    .poke-vector-wrap {
      position: relative;
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
    }
    .poke-shield-bg {
      position: absolute;
      width: 110px;
      height: 110px;
      pointer-events: none;
    }
    .poke-art-icon {
      font-size: 56px;
      color: #ffd166;
      filter: drop-shadow(0 0 10px rgba(255, 209, 102, 0.7));
      transition: transform 0.3s ease;
    }
    .pokemon-card:hover .poke-art-icon {
      transform: scale(1.12);
    }
    .poke-lvl-stamp {
      position: absolute;
      top: 6px;
      right: 6px;
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid #ffd166;
      color: #ffd166;
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      padding: 2px 5px;
      border-radius: 4px;
    }

    /* Body */
    .poke-body {
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .poke-title {
      font-size: 14px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 6px;
      line-height: 1.3;
    }
    .poke-caption {
      font-size: 12px;
      color: #a7c8dc;
      line-height: 1.45;
      margin: 0 0 10px;
      flex: 1;
    }
    .poke-lore-box {
      background: rgba(0, 0, 0, 0.35);
      border-left: 2px solid #ffd166;
      padding: 6px 8px;
      border-radius: 0 4px 4px 0;
      font-size: 11px;
      line-height: 1.4;
      display: none;
    }
    html[data-lore="1"] .poke-lore-box {
      display: block;
    }
    .lore-label {
      color: #ffd166;
      font-weight: bold;
      font-size: 9px;
      font-family: 'Press Start 2P', monospace;
      margin-right: 4px;
    }
    .lore-text {
      color: #e2f0fa;
      font-style: italic;
    }

    /* Card Footer & Rarity Stamp */
    .poke-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px solid rgba(56, 199, 231, 0.15);
      font-size: 9px;
      font-family: 'Press Start 2P', monospace;
    }
    .poke-rarity-stamp {
      letter-spacing: 0.5px;
    }
    .poke-rarity-stamp.ultimate { color: #ffd166; text-shadow: 0 0 6px rgba(255, 209, 102, 0.5); }
    .poke-rarity-stamp.prestige { color: #38C7E7; }
    .poke-rarity-stamp.special { color: #06d6a0; }
    .poke-rarity-stamp.locked { color: #8dafc2; }
    .poke-card-id {
      color: #6a8ea3;
    }

    /* Holo Overlay */
    .holo-foil-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.08) 45%, rgba(56, 199, 231, 0.15) 50%, transparent 60%);
      pointer-events: none;
      opacity: 0.7;
    }
  </style>

  <script is:inline>
    // Lore Mode: persist & broadcast as a global attribute
    (function(){
      const KEY = 'hw.lore';
      const box = document.getElementById('loreToggle');
      const set = (on) => document.documentElement.setAttribute('data-lore', on ? '1' : '0');

      const saved = localStorage.getItem(KEY);
      if (saved !== null) box.checked = saved === '1';
      set(box.checked);

      box.addEventListener('change', () => {
        set(box.checked);
        localStorage.setItem(KEY, box.checked ? '1' : '0');
      });
    })();

    // Badge filtering logic
    (function(){
      const filterBar = document.getElementById('badgeFilters');
      const cards = document.querySelectorAll('#badgeGrid .pokemon-card');
      if (!filterBar) return;

      filterBar.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-chip');
        if (!btn) return;

        filterBar.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.dataset.filter;
        cards.forEach((card) => {
          if (filter === 'all') {
            card.style.display = 'flex';
          } else if (filter === 'earned') {
            card.style.display = card.dataset.earned === 'true' ? 'flex' : 'none';
          } else if (filter === 'pending') {
            card.style.display = card.dataset.pending === 'true' ? 'flex' : 'none';
          } else if (filter === 'ultimate') {
            card.style.display = card.dataset.tier === 'ultimate' ? 'flex' : 'none';
          } else if (filter === 'locked') {
            card.style.display = (card.dataset.earned === 'false' && card.dataset.tier === 'locked') ? 'flex' : 'none';
          }
        });
      });
    })();
  </script>
</section>
