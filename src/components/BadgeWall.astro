---
/*
 * Path: src/components/BadgeWall.astro
 * Purpose: Zone 4 (Trophy Armory) rendering holographic TCG achievement badges,
 *          accessible focusgroup="tablist nomemory" category filters with fallback,
 *          and Lore Mode switch.
 * Spec Reference: SPEC-020 (020-hero-wall-16bit-overworld-implementation)
 */
import { badges as defaultBadges } from '../data/badges';

type Tier = 'ultimate' | 'prestige' | 'special' | 'locked';
type Badge = {
  name: string;
  caption: string;
  icon: string;
  xp?: number | null;
  tier: Tier;
  earned: boolean;
  tooltip?: string;
  lore?: string;
  category: string;
  date?: string;
  level?: number | null;
};

const input: Badge[] = (Astro.props.badges as Badge[]) ?? defaultBadges;

// Sort: Tier -> Date (desc)
const order: Record<Tier, number> = { ultimate: 0, prestige: 1, special: 2, locked: 3 };
const sorted: Badge[] = [...input].sort((a, b) => {
  const tierDelta = order[a.tier] - order[b.tier];
  if (tierDelta) return tierDelta;
  return (b.date ?? '').localeCompare(a.date ?? '');
});
---

<section id="trophies" data-zone="trophies" class="section zone-section">
  <div class="inner">
    <h2 class="banner">Trophy Armory</h2>

    <div class="panel md3-trophies-panel" style="margin-top:12px">
      <!-- Top Controls & Accessible Filter Tablist -->
      <div class="trophies-toolbar">
        <div
          class="filter-tabs"
          id="badgeFilters"
          focusgroup="tablist nomemory"
          aria-label="Filter trophy cards"
        >
          <button
            type="button"
            role="tab"
            id="tab-all"
            class="filter-chip"
            data-filter="all"
            aria-selected="true"
            focusgroupstart
          >All Cards ({sorted.length})</button>
          <button
            type="button"
            role="tab"
            id="tab-earned"
            class="filter-chip"
            data-filter="earned"
            aria-selected="false"
          >Unlocked ({sorted.filter(b => b.earned).length})</button>
          <button
            type="button"
            role="tab"
            id="tab-pending"
            class="filter-chip"
            data-filter="pending"
            aria-selected="false"
          >Pending Quests ({sorted.filter(b => !b.earned && b.tier !== 'locked').length})</button>
          <button
            type="button"
            role="tab"
            id="tab-ultimate"
            class="filter-chip"
            data-filter="ultimate"
            aria-selected="false"
          >Ultimate ({sorted.filter(b => b.tier === 'ultimate').length})</button>
          <button
            type="button"
            role="tab"
            id="tab-locked"
            class="filter-chip"
            data-filter="locked"
            aria-selected="false"
          >Mystery / Locked</button>
        </div>

        <div class="lore-toggle-wrap">
          <label class="badge-lore-toggle" for="loreToggle">
            <input id="loreToggle" type="checkbox" />
            <span class="label">Lore Mode</span>
          </label>
        </div>
      </div>

      <!-- Collectible TCG Badge Grid inside accessible tabpanel -->
      <div id="badgeGridPanel" role="tabpanel" aria-labelledby="tab-all" tabindex="0">
        <div class="pokemon-badge-grid" id="badgeGrid">
          {sorted.map((b, index) => {
            const iconSrc = b.icon?.startsWith('/') ? b.icon : `/badges/${b.icon}`;
            const lvl = (b.name.match(/Lvl\s*(\d+)/)?.[1]) ?? '';
            const categoryName = (b.category ?? 'system').toUpperCase();
            const cardNum = String(index + 1).padStart(3, '0');
            const detailHtml = [
              `<p>${b.caption}</p>`,
              b.lore ? `<p><strong>Lore:</strong> ${b.lore}</p>` : ''
            ].join('');

            return (
              <article
                class={`pokemon-card tier-${b.tier} ${b.earned ? 'unlocked' : 'locked'}`}
                data-tier={b.tier}
                data-earned={b.earned ? 'true' : 'false'}
                data-pending={!b.earned && b.tier !== 'locked' ? 'true' : 'false'}
                data-tip={b.tooltip}
                data-category={b.category}
                data-title={b.name}
                data-html={detailHtml}
              >
                <!-- Card Header: Type Tag & XP Rating -->
                <div class="poke-head">
                  <span class={`poke-type-badge ${b.category}`}>
                    <iconify-icon icon={
                      b.category === 'system' ? 'pixelarticons:cpu' :
                      b.category === 'sanctuary' ? 'pixelarticons:home' :
                      b.category === 'discipline' ? 'pixelarticons:shield' :
                      b.category === 'burn' ? 'pixelarticons:zap' :
                      b.category === 'food' ? 'pixelarticons:heart' :
                      b.category === 'urban' ? 'pixelarticons:human-handsup' :
                      'pixelarticons:coin'
                    } aria-hidden="true"></iconify-icon>
                    {categoryName}
                  </span>
                  <span class="poke-hp-xp">
                    {b.xp != null ? `${b.xp} XP` : '???'}
                  </span>
                </div>

                <!-- Artwork Frame with Holographic Glow & Fallback Shield -->
                <div class="poke-art-frame">
                  <div class="holo-shimmer" aria-hidden="true"></div>
                  {b.icon?.includes(':') ? (
                    <div class="poke-vector-wrap">
                      <svg class="poke-shield-bg" viewBox="0 0 100 100" aria-hidden="true">
                        <polygon points="50,5 90,20 90,65 50,95 10,65 10,20" fill="rgba(56,199,231,0.12)" stroke="rgba(56,199,231,0.5)" stroke-width="2"/>
                      </svg>
                      <iconify-icon icon={b.icon} class="poke-art-icon" aria-hidden="true"></iconify-icon>
                    </div>
                  ) : (
                    <>
                      <img
                        src={iconSrc}
                        alt={b.name}
                        loading="lazy"
                        data-badge-img
                      />
                      <div class="poke-fallback-shield" hidden aria-hidden="true">
                        <svg viewBox="0 0 100 100" width="64" height="64">
                          <polygon points="50,5 90,20 90,65 50,95 10,65 10,20" fill="rgba(255,209,102,0.15)" stroke="#ffd166" stroke-width="3"/>
                          <circle cx="50" cy="48" r="16" fill="rgba(56,199,231,0.25)" stroke="#38c7e7" stroke-width="2"/>
                        </svg>
                      </div>
                    </>
                  )}
                  {lvl && <div class="poke-lvl-stamp">LVL {lvl}</div>}
                </div>

                <!-- Card Body: Title & Ability / Caption -->
                <div class="poke-body">
                  <h3 class="poke-title">{b.name}</h3>
                  <p class="poke-caption">{b.caption}</p>
                  {b.lore && (
                    <div class="poke-lore-box">
                      <span class="lore-label">LORE:</span>
                      <span class="lore-text">{b.lore}</span>
                    </div>
                  )}
                </div>

                <!-- Card Footer with Rarity Stamp & Inspect Trigger -->
                <div class="poke-card-footer">
                  <span class={`poke-rarity-stamp ${b.tier}`}>
                    {b.tier === 'ultimate' ? 'ULTIMATE RARE' :
                     b.tier === 'prestige' ? 'PRESTIGE' :
                     b.tier === 'special' ? 'SPECIAL' : 'LOCKED'}
                  </span>
                  <div class="poke-footer-actions">
                    <span class="poke-card-id">#HQ-{cardNum}</span>
                    <button
                      type="button"
                      class="poke-inspect-btn"
                    >Inspect<span class="visually-hidden"> {b.name}</span></button>
                  </div>
                </div>

                <!-- Holographic Foil Sheen Overlay -->
                <div class="holo-foil-overlay" aria-hidden="true"></div>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <style>
    .md3-trophies-panel {
      background: linear-gradient(180deg, rgba(20, 36, 50, 0.95) 0%, rgba(10, 20, 30, 0.98) 100%);
      border: 2px solid rgba(56, 199, 231, 0.3);
      border-radius: 12px;
      padding: 22px;
    }
    .trophies-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 24px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(56, 199, 231, 0.2);
    }
    /* Single-row horizontally scrollable tablist per modern-web-guidance tabs */
    .filter-tabs {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 8px;
      max-width: 100%;
      padding-block-end: 4px;
      scroll-snap-type: inline proximity;
      scrollbar-width: thin;
      scrollbar-color: rgba(56, 199, 231, 0.35) transparent;
    }
    .filter-chip {
      position: relative;
      flex: none;
      scroll-snap-align: start;
      min-height: 44px;
      background: rgba(28, 59, 84, 0.4);
      border: 1px solid rgba(56, 199, 231, 0.3);
      color: #cde6f5;
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .filter-chip:hover {
      background: rgba(56, 199, 231, 0.2);
      border-color: rgba(56, 199, 231, 0.6);
      color: #fff;
    }
    /* Selection styled strictly from aria-selected without altering font-weight or box size */
    #badgeFilters [role="tab"][aria-selected="true"] {
      background: rgba(56, 199, 231, 0.22);
      color: #ffffff;
      border-color: var(--cyan);
    }
    #badgeFilters [role="tab"][aria-selected="true"]::after {
      content: "";
      position: absolute;
      inset: auto 12px -1px;
      border-block-end: 3px solid var(--cyan);
    }

    .lore-toggle-wrap {
      display: flex;
      align-items: center;
    }
    .badge-lore-toggle {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 4px 8px;
      cursor: pointer;
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: #ffd166;
    }

    /* Pokemon-Style Badge Grid */
    .pokemon-badge-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
    }

    .pokemon-card {
      position: relative;
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      background: linear-gradient(145deg, #162a3b 0%, #0c1822 100%);
      border: 3px solid rgba(56, 199, 231, 0.35);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s ease, border-color 0.25s ease;
      cursor: pointer;
      overflow: hidden;
    }
    .pokemon-card:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.7), 0 0 20px rgba(56, 199, 231, 0.35);
      border-color: rgba(56, 199, 231, 0.75);
    }

    /* Tier Styles */
    .pokemon-card.tier-ultimate {
      border-color: #ffd166;
      box-shadow: 0 6px 20px rgba(255, 209, 102, 0.25), inset 0 0 12px rgba(255, 209, 102, 0.15);
    }
    .pokemon-card.tier-ultimate:hover {
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 209, 102, 0.45);
    }
    .pokemon-card.tier-prestige { border-color: #38C7E7; }
    .pokemon-card.tier-special { border-color: #06d6a0; }
    .pokemon-card.locked {
      filter: grayscale(0.85) opacity(0.75);
      border-color: rgba(140, 160, 180, 0.3);
    }
    .pokemon-card.locked:hover {
      filter: grayscale(0.5) opacity(0.95);
    }

    /* Card Head */
    .poke-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .poke-type-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
      background: rgba(56, 199, 231, 0.15);
      color: #38C7E7;
      border: 1px solid rgba(56, 199, 231, 0.4);
      letter-spacing: 0.5px;
    }
    .poke-type-badge.sanctuary { background: rgba(6, 214, 160, 0.2); color: #06d6a0; border-color: #06d6a0; }
    .poke-type-badge.discipline { background: rgba(255, 209, 102, 0.2); color: #ffd166; border-color: #ffd166; }
    .poke-type-badge.burn { background: rgba(193, 46, 40, 0.2); color: #ff7570; border-color: #ff7570; }

    .poke-hp-xp {
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: #ffd166;
      text-shadow: 0 1px 2px #000;
      font-variant-numeric: tabular-nums;
    }

    /* Art Frame */
    .poke-art-frame {
      position: relative;
      height: 140px;
      background: radial-gradient(circle at center, #1e3a52 0%, #0d1a24 100%);
      border: 2px solid rgba(0, 0, 0, 0.6);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 12px;
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6);
    }
    .poke-art-frame img {
      max-height: 110px;
      max-width: 90%;
      object-fit: contain;
      image-rendering: pixelated;
      transition: transform 0.3s ease;
    }
    .pokemon-card:hover .poke-art-frame img {
      transform: scale(1.08);
    }
    .poke-vector-wrap,
    .poke-fallback-shield {
      position: relative;
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
    }
    .poke-shield-bg {
      position: absolute;
      width: 110px;
      height: 110px;
      pointer-events: none;
    }
    .poke-art-icon {
      font-size: 56px;
      color: #ffd166;
      filter: drop-shadow(0 0 10px rgba(255, 209, 102, 0.7));
      transition: transform 0.3s ease;
    }
    .pokemon-card:hover .poke-art-icon {
      transform: scale(1.12);
    }
    .poke-lvl-stamp {
      position: absolute;
      top: 6px;
      right: 6px;
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid #ffd166;
      color: #ffd166;
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      padding: 2px 5px;
      border-radius: 4px;
    }

    /* Body */
    .poke-body {
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .poke-title {
      font-size: 14px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 6px;
      line-height: 1.3;
    }
    .poke-caption {
      font-size: 12.5px;
      color: #a7c8dc;
      line-height: 1.45;
      margin: 0 0 10px;
      flex: 1;
    }
    .poke-lore-box {
      background: rgba(0, 0, 0, 0.35);
      border-left: 1px solid #ffd166;
      padding: 6px 8px;
      border-radius: 0 4px 4px 0;
      font-size: 11.5px;
      line-height: 1.4;
      display: none;
    }
    html[data-lore="1"] .poke-lore-box {
      display: block;
    }
    .lore-label {
      color: #ffd166;
      font-weight: bold;
      font-size: 9px;
      font-family: 'Press Start 2P', monospace;
      margin-right: 4px;
    }
    .lore-text {
      color: #e2f0fa;
      font-style: italic;
    }

    /* Card Footer & Inspect Trigger */
    .poke-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px solid rgba(56, 199, 231, 0.15);
      font-size: 9px;
      font-family: 'Press Start 2P', monospace;
    }
    .poke-rarity-stamp { letter-spacing: 0.5px; }
    .poke-rarity-stamp.ultimate { color: #ffd166; text-shadow: 0 0 6px rgba(255, 209, 102, 0.5); }
    .poke-rarity-stamp.prestige { color: #38C7E7; }
    .poke-rarity-stamp.special { color: #06d6a0; }
    .poke-rarity-stamp.locked { color: #8dafc2; }
    .poke-footer-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .poke-card-id { color: #8dafc2; }
    .poke-inspect-btn {
      background: rgba(56, 199, 231, 0.1);
      border: 1px solid rgba(56, 199, 231, 0.35);
      border-radius: 4px;
      color: #bfe9f8;
      font-family: 'Press Start 2P', monospace;
      font-size: 9px;
      min-height: 28px;
      padding: 4px 8px;
      cursor: pointer;
    }
    .poke-inspect-btn:hover {
      background: rgba(56, 199, 231, 0.25);
      color: #fff;
    }

    /* Holo Overlay */
    .holo-foil-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg, transparent 20%, rgba(255, 255, 255, 0.08) 45%, rgba(56, 199, 231, 0.15) 50%, transparent 60%);
      pointer-events: none;
      opacity: 0.7;
    }
  </style>

  <script is:inline>
    // Lore Mode: persist & broadcast as html[data-lore="1"|"0"]
    (function () {
      const KEY = 'hw.lore';
      const box = document.getElementById('loreToggle');
      if (!box) return;
      const setLore = (on) => document.documentElement.setAttribute('data-lore', on ? '1' : '0');

      const saved = localStorage.getItem(KEY);
      if (saved !== null) box.checked = saved === '1';
      setLore(box.checked);

      box.addEventListener('change', () => {
        setLore(box.checked);
        localStorage.setItem(KEY, box.checked ? '1' : '0');
      });
    })();

    // Fallback shield reveal for badge images without inline event handlers
    document.querySelectorAll('#badgeGrid img[data-badge-img]').forEach((img) => {
      const showShield = () => {
        img.hidden = true;
        const shield = img.nextElementSibling;
        if (shield) shield.hidden = false;
      };
      img.addEventListener('error', showShield);
      if (img.complete && img.naturalWidth === 0) showShield();
    });

    // Accessible Trophy Armory filter tablist (focusgroup="tablist nomemory" + fallback)
    (function () {
      const tablist = document.getElementById('badgeFilters');
      const panel = document.getElementById('badgeGridPanel');
      const cards = Array.from(document.querySelectorAll('#badgeGrid .pokemon-card'));
      if (!tablist) return;

      const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
      const hasNativeFocusGroup = 'focusGroup' in HTMLElement.prototype;

      function applyFilter(filter) {
        for (const card of cards) {
          let show = false;
          if (filter === 'all') show = true;
          else if (filter === 'earned') show = card.dataset.earned === 'true';
          else if (filter === 'pending') show = card.dataset.pending === 'true';
          else if (filter === 'ultimate') show = card.dataset.tier === 'ultimate';
          else if (filter === 'locked') show = card.dataset.earned === 'false' && card.dataset.tier === 'locked';
          card.style.display = show ? 'flex' : 'none';
        }
      }

      function selectTab(target, focusTab = false) {
        if (!target) return;
        for (const tab of tabs) {
          const active = tab === target;
          tab.setAttribute('aria-selected', String(active));
          tab.toggleAttribute('focusgroupstart', active);
          if (!hasNativeFocusGroup) {
            tab.tabIndex = active ? 0 : -1;
          }
        }
        if (panel && target.id) {
          panel.setAttribute('aria-labelledby', target.id);
        }
        target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        applyFilter(target.dataset.filter || 'all');
        if (focusTab) target.focus();
      }

      // Initialize roving tabindex only when native focusgroup is unavailable
      if (!hasNativeFocusGroup) {
        tabs.forEach((tab) => {
          tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1;
        });
      }

      tablist.addEventListener('click', (e) => {
        const tab = e.target.closest('[role="tab"]');
        if (tab) selectTab(tab, false);
      });

      // Selection follows focus so native focusgroup arrow navigation updates panel state immediately
      tablist.addEventListener('focusin', (e) => {
        const tab = e.target.closest('[role="tab"]');
        if (tab && tab.getAttribute('aria-selected') !== 'true') {
          selectTab(tab, false);
        }
      });

      // Fallback Left/Right/Home/End keyboard navigation when !('focusGroup' in HTMLElement.prototype)
      if (!hasNativeFocusGroup) {
        tablist.addEventListener('keydown', (e) => {
          const current = e.target.closest('[role="tab"]');
          if (!current) return;
          const idx = tabs.indexOf(current);
          if (idx === -1) return;

          let nextIdx = -1;
          if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') nextIdx = 0;
          else if (e.key === 'End') nextIdx = tabs.length - 1;

          if (nextIdx !== -1) {
            e.preventDefault();
            selectTab(tabs[nextIdx], true);
          }
        });
      }

      // Open native modal when inspecting any Trophy card
      document.getElementById('badgeGrid')?.addEventListener('click', (e) => {
        const card = e.target.closest('.pokemon-card');
        if (!card) return;
        window.HeroWallModal?.open?.({
          title: card.dataset.title || 'Trophy Card',
          html: card.dataset.html || ''
        });
      });
    })();
  </script>
</section>
